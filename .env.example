# Copy to .env.local for local development (npm run dev). Never commit .env.local.
DATABASE_URL=postgres://localhost/bfmh_dev
ADMIN_PASSWORD=owner123
SESSION_SECRET=change-me-locally
SITE_URL=http://localhost:3456
# Optional notification channels
# GROUPME_BOT_ID=
# GROUPME_WEBHOOK_SECRET=   # lets the bot READ the chat: callback URL = /api/webhooks/groupme?secret=<this>
# GROUPME_GROUP_ID=        # optional: ignore callbacks from any other group
# GROUPME_BOT_ACK=0        # optional: stop the bot from replying "Noted…" in the chat
# RESEND_API_KEY=
